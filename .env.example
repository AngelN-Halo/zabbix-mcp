# Copy to .env for Compose settings; copy only upstream fields to .env.upstream.
ZABBIX_URL=https://zabbix.example.org
ZABBIX_API_TOKEN=REPLACE_ME
ZABBIX_REQUEST_TIMEOUT=15
ZABBIX_CACHE_SECONDS=30
ZABBIX_MCP_PORT=8300
ZABBIX_OPENAPI_PORT=8301
MCPO_API_KEY=REPLACE_ME
MCP_ALLOWED_HOSTS=127.0.0.1,127.0.0.1:*,localhost,localhost:*,zabbix-mcp,zabbix-mcp:*
